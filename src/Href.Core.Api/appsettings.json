{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{CorrelationId}] [{AppKey}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "Smtp": {
    "Host": "smtp.gmail.com",
    "Port": 465,
    "SecureSocket": "SslOnConnect",
    "FromEmail": "href.notifier@gmail.com",
    "FromName": "Href"
  },
  "AllowedHosts": "*"
}
